// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * MERCURY D121G
 *   SoC      : MediaTek MT7620DA (integrated 64MB DDR2, no external RAM)
 *   2.4GHz   : MT7620 built-in (rt2800soc)
 *   5GHz     : MT7612EN via PCIe (mt76x2e)
 *   Switch   : Realtek RTL8367S-CG, 3x Gigabit
 *   Flash    : W25Q128 (16MB SPI-NOR)
 *   U-Boot   : stock Ralink/Realtek-SDK 1.1.3, serial console 57600 8N1
 *
 * WiFi calibration (from the ORIGINAL 2MB dump, verified byte-exact):
 *   0xF800  2.4G EEPROM, 0x200 bytes  (MT7620, MAC at +0x4 = 00:0c:43:76:20:58)
 *   0xFC00  5G   EEPROM, 0x200 bytes  (MT7612, MAC at +0x4 = 00:0c:43:47:c2:80)
 * These sit inside the first 64KB of flash, right after U-Boot, so the
 * partition layout below mirrors that reality instead of the usual
 * "factory at 0x40000" convention.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "mt7620a.dtsi"

/ {
	compatible = "mercury,d121g", "ralink,mt7620a-soc";
	model = "MERCURY D121G";

	chosen {
		/* stock U-Boot runs 57600 on this board, not the usual 115200 */
		bootargs = "console=ttyS0,57600";
	};

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &ethernet;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_power: power {
			function = LED_FUNCTION_POWER;
			color = <LED_COLOR_ID_GREEN>;
			/* GPIO42 = bank2 line 2 */
			gpios = <&gpio2 2 GPIO_ACTIVE_LOW>;
		};
	};

	rtl8367s {
		compatible = "realtek,rtl8367b";
		/*
		 * cpu_port txdelay rxdelay mode force txpause rxpause link duplex speed
		 * cpu_port 7 -> extif1 on RTL8367S; RGMII; forced 1000M full duplex.
		 * mode 1 = RGMII, speed 2 = 1000M.
		 */
		realtek,extif = <7 1 0 1 1 1 1 1 1 2>;
		mii-bus = <&mdio0>;
		phy-id = <29>;
	};
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <30000000>;

		/*
		 * 必需：否则 of_translate_address() 无法给下面的 partitions
		 * 做地址翻译，内核每次都会喊
		 *   OF: Bad cell count for .../flash@0/partitions
		 * （分区照样建得出来，但告警是 DTS 缺属性，不是噪音）。
		 * 与 Archer C5 v4 的写法保持一致。
		 */
		#address-cells = <1>;
		#size-cells = <1>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/*
			 * U-Boot occupies the start of flash; the stock binary ends
			 * around 0xF100, so 0xF800 is a safe split point.
			 */
			partition@0 {
				label = "u-boot";
				reg = <0x0 0xf800>;
				read-only;
			};

			/*
			 * Factory / radio calibration, located at 0xF800 in the
			 * original layout.  Mirrored here so the same DTS works both
			 * for TFTP bring-up on the stock flash and for a freshly
			 * written 16MB image.
			 */
			factory: partition@f800 {
				label = "factory";
				reg = <0xf800 0x800>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_radio_0: eeprom@0 {
						reg = <0x0 0x200>;
					};

					eeprom_radio_5g: eeprom@400 {
						reg = <0x400 0x200>;
					};

					macaddr_factory_4: macaddr@4 {
						compatible = "mac-base";
						reg = <0x4 0x6>;
						#nvmem-cell-cells = <1>;
					};
				};
			};

			/*
			 * Vendor "MINIFS" data block.  Size taken from the stock
			 * layout descriptor at 0x15000, which chains:
			 *   0xF000 +0x800 -> 0xF800
			 *   0xF800 +0x800 -> 0x10000
			 *   0x10000 +0x5000 -> 0x15000   (i.e. MINIFS is 20 KiB, not 64)
			 */
			partition@10000 {
				label = "minifs";
				reg = <0x10000 0x5000>;
				read-only;
			};

			/*
			 * Kernel + rootfs.  U-Boot reads firmware payload from
			 * flash offset 0x15200 (confirmed by U-Boot constant table
			 * at file 0x9780: 0xBC015200).  The 0x200-byte vendor header
			 * at 0x15000 declares "payload at 0x15200".
			 */
			/*
			 * Kernel + rootfs.  U-Boot always reads the raw LZMA
			 * from flash 0x15200, but the partition itself must
			 * start at a 4K-aligned offset, otherwise mtdpart
			 * forces it read-only and rootfs_data becomes
			 * unusable (0x15200 mod 4K != 0).
			 * 0x15000 is 0 mod 4K, so it stays writable.
			 * The 13 bytes at 0x15000 are replaced by a dummy
			 * LZMA header so mtdsplit_lzma accepts this
			 * partition; U-Boot never reads them (the vendor
			 * container magic appears nowhere in U-Boot).
			 */
			partition@15000 {
				compatible = "lzma";
				label = "firmware";
				reg = <0x15000 0xfeb000>;
			};
		};
	};
};

&state_default {
	gpio {
		groups = "i2c", "uartf", "ephy", "rgmii2";
		function = "gpio";
	};
};

&ethernet {
	pinctrl-names = "default";
	pinctrl-0 = <&rgmii1_pins &mdio_pins>;

	nvmem-cells = <&macaddr_factory_4 0>;
	nvmem-cell-names = "mac-address";

	port@5 {
		status = "okay";
		mediatek,fixed-link = <1000 1 1 1>;
		phy-mode = "rgmii";
	};

	mdio0: mdio-bus {
		status = "okay";
		/*
		 * The Archer C5 v4 resets the switch via gpio2 20.  The D121G
		 * GPIO map is not confirmed yet, and a wrong reset line would
		 * hold the switch in reset, so it is deliberately omitted for
		 * first bring-up: the stock U-Boot already runs
		 * rtl_init_switch()/rtk_vlan_init(), leaving the switch usable.
		 */
	};
};

&pcie {
	status = "okay";
};

&pcie0 {
	wifi: mt76@0,0 {
		reg = <0x0000 0 0 0 0>;
		ieee80211-freq-limit = <5000000 6000000>;
		nvmem-cells = <&eeprom_radio_5g>, <&macaddr_factory_4 2>;
		nvmem-cell-names = "eeprom", "mac-address";
	};
};

&wmac {
	nvmem-cells = <&eeprom_radio_0>, <&macaddr_factory_4 0>;
	nvmem-cell-names = "eeprom", "mac-address";
};
